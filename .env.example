# Copy this file to backend/.env and fill in YOUR values. Never commit backend/.env.

# --- AI Providers (Amulya queries both Gemini & Groq and selects the best response) ---

# 1. Google Gemini API (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud API (Get free key at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Anthropic Claude (Optional alternative)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Safety: keep this true for the prototype. true = NO real messages can be sent. ---
DEMO_MODE=true
